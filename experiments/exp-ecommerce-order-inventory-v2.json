      "validation-results.json",
      "certification-record.json",
      "summary.json",
      "report.html",
      "report.md"
    ],
    "checksums": {
      "algorithm": "SHA-256",
      "required": true
    },
    "immutability": {
      "enabled": true,
      "mode": "COMPLIANCE",
      "retentionDays": 90
    },
    "lineage": {
      "enabled": true,
      "requireParentReferences": true
    }
  },
  "certification": {
    "enabled": true,
    "gates": [
      {
        "id": "G1",
        "name": "Deterministic Workload",
        "condition": "TRACE_HASH_VERIFIED"
      },
      {
        "id": "G2",
        "name": "Fault Timeline Integrity",
        "condition": "FAULT_HASH_VERIFIED"
      },
      {
        "id": "G3",
        "name": "Telemetry Integrity",
        "condition": "ALL_REQUIRED_FIELDS_PRESENT"
      },
      {
        "id": "G4",
        "name": "Statistical Fidelity",
        "condition": "STATISTICAL_THRESHOLDS_PASS"
      },
      {
        "id": "G5",
        "name": "Engineering Bounds",
        "condition": "SLO_THRESHOLDS_PASS"
      },
      {
        "id": "G6",
        "name": "Consistency Correctness",
        "condition": "CONSISTENCY_CHECKS_PASS"
      },
      {
        "id": "G7",
        "name": "Calibration Integrity",
        "condition": "ZERO_LEAKAGE_AND_CONVERGED"
      },
      {
        "id": "G8",
        "name": "Artifact Integrity",
        "condition": "SHA256_AND_LINEAGE_VERIFIED"
      }
    ],
    "failCertificationOn": [
      "LOST_WRITE",
      "QUORUM_VIOLATION",
      "ARTIFACT_HASH_MISMATCH",
      "VALIDATION_LEAKAGE",
      "INVALID_TRACE_HASH",
      "INVALID_FAULT_HASH"
    ]
  },
  "reproducibility": {
    "enabled": true,
    "capture": [
      "gitCommit",
      "gitBranch",
      "compilerVersions",
      "runtimeVersions",
      "operatingSystem",
      "cpu",
      "memory",
      "environmentVariablesHash",
      "dependencyLockHash",
