    ],
    "rerun": {
      "enabled": true,
      "rerunCount": 2,
      "requireEquivalentTrace": true,
      "requireEquivalentFaultTimeline": true
    }
  },
  "exitCriteria": {
    "experimentCompleteWhen": [
      "all_workload_operations_completed",
