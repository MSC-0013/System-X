      "calibration-convergence",
      "parameter-search",
      "slo-budget"
    ]
  },
  "artifacts": {
    "root": "s3://system-x-artifacts/experiments/exp-ecommerce-order-catalog-20260919-001",
    "files": [
      "experiment.json",
      "project.json",
      "cluster.json",
      "dataset.json",
      "workload-spec.json",
      "workload-trace.json",
