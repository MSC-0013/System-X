    "@system-x/campaign-engine": "workspace:*",
    "@system-x/certification-gate": "workspace:*",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "@types/node": "^24.0.0"
