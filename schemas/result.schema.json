{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://system-x.io/schemas/result.schema.json",
  "title": "IntegratedRunResult",
  "type": "object",
  "required": [
    "integrationRunId",
    "experimentSpecHash",
    "contractVersion",
    "status",
    "startedAt",
    "completedAt",
    "metrics"
  ],
  "properties": {
    "integrationRunId": {
      "type": "string"
    },
    "experimentSpecHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "traceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blackboxRunId": {
      "type": "string"
    },
    "quorumRunId": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "VALIDATED",
        "COMPILED",
        "SIMULATED",
        "TARGET_READY",
        "RUNNING",
        "OBSERVING",
        "NORMALIZED",
        "COMPARED",
        "CALIBRATING",
        "VALIDATING",
        "CERTIFIED",
        "FAILED",
        "ABORTED",
        "CANCELLED",
        "TIMEOUT"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "required": [
        "integrationRunId",
        "experimentSpecHash",
        "systemXVersion",
        "blackboxVersion",
        "blackboxGitSha",
        "quorumVersion",
        "quorumGitSha",
        "schemaVersion",
        "infrastructureProfile",
        "createdAt"
      ],
      "properties": {
        "integrationRunId": { "type": "string" },
        "experimentSpecHash": { "type": "string" },
        "traceHash": { "type": "string" },
        "systemXVersion": { "type": "string" },
        "blackboxVersion": { "type": "string" },
        "blackboxGitSha": { "type": "string" },
        "blackboxImageDigest": { "type": "string" },
        "quorumVersion": { "type": "string" },
        "quorumGitSha": { "type": "string" },
        "quorumImageDigest": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "infrastructureProfile": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "totalOperations",
        "successfulOperations",
        "failedOperations",
        "throughputOpsSec",
        "p50LatencyMs",
        "p90LatencyMs",
        "p95LatencyMs",
        "p99LatencyMs"
      ],
      "properties": {
        "totalOperations": { "type": "integer", "minimum": 0 },
        "successfulOperations": { "type": "integer", "minimum": 0 },
        "failedOperations": { "type": "integer", "minimum": 0 },
        "throughputOpsSec": { "type": "number", "minimum": 0.0 },
        "p50LatencyMs": { "type": "number", "minimum": 0.0 },
        "p90LatencyMs": { "type": "number", "minimum": 0.0 },
        "p95LatencyMs": { "type": "number", "minimum": 0.0 },
        "p99LatencyMs": { "type": "number", "minimum": 0.0 },
        "minLatencyMs": { "type": "number", "minimum": 0.0 },
        "maxLatencyMs": { "type": "number", "minimum": 0.0 },
        "meanLatencyMs": { "type": "number", "minimum": 0.0 },
        "staleReadCount": { "type": "integer", "minimum": 0 },
        "staleReadRate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "causalAnomalies": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "operationType",
          "success",
          "source"
        ],
        "properties": {
          "operationId": { "type": "string" },
          "operationType": { "type": "string", "enum": ["READ", "WRITE", "DELETE"] },
          "latencyMs": { "type": "number", "minimum": 0.0 },
          "success": { "type": "boolean" },
          "source": {
            "type": "string",
            "enum": [
              "BLACKBOX_SIMULATION",
              "BLACKBOX_REAL",
              "QUORUM_NODE",
              "QUORUM_CLIENT"
            ]
          },
          "nodeId": { "type": "string" },
          "errorCode": { "type": "string" },
          "semanticCategory": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "ROUTING_RETRYABLE_FAILURE",
              "WRITE_AVAILABILITY_FAILURE",
              "READ_AVAILABILITY_FAILURE",
              "LEADERSHIP_SAFETY_FAILURE",
              "MEMBERSHIP_SAFETY_FAILURE",
              "COORDINATION_LEASE_EXPIRED",
              "CONSISTENCY_REQUIREMENT_FAILURE",
              "INTERNAL_STORAGE_FAILURE"
            ]
          },
          "staleRead": { "type": "boolean" },
          "causalAnomaly": { "type": "boolean" },
          "simulationTimeUs": { "type": "number", "minimum": 0.0 },
          "realElapsedUs": { "type": "number", "minimum": 0.0 },
          "wallTimeMs": { "type": "number", "minimum": 0.0 },
          "monotonicNs": { "type": "number", "minimum": 0.0 }
        },
        "additionalProperties": false
      }
    },
    "divergence": {
      "type": "object",
      "required": [
        "ksStatistic",
        "ksPValue",
        "wassersteinDistance",
        "p50Mape",
        "p95Mape",
        "p99Mape",
        "throughputMape",
        "calibrated",
        "certified"
      ],
      "properties": {
        "ksStatistic": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "ksPValue": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "wassersteinDistance": { "type": "number", "minimum": 0.0 },
        "p50Mape": { "type": "number", "minimum": 0.0 },
        "p95Mape": { "type": "number", "minimum": 0.0 },
        "p99Mape": { "type": "number", "minimum": 0.0 },
        "throughputMape": { "type": "number", "minimum": 0.0 },
        "calibrated": { "type": "boolean" },
        "certified": { "type": "boolean" },
        "certificationDetails": {
          "type": "object",
          "required": [
            "passed",
            "hypothesisAccepted",
            "dKsWithinEngineeringLimit",
            "p99MapeWithinLimit",
            "throughputMapeWithinLimit"
          ],
          "properties": {
            "passed": { "type": "boolean" },
            "hypothesisAccepted": { "type": "boolean" },
            "dKsWithinEngineeringLimit": { "type": "boolean" },
            "p99MapeWithinLimit": { "type": "boolean" },
            "throughputMapeWithinLimit": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
