{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://system-x.io/schemas/workload.schema.json",
  "title": "IntegratedWorkload",
  "type": "object",
  "required": [
    "operationCount",
    "concurrency",
    "distribution",
    "readRatio",
    "writeRatio",
    "keyRange"
  ],
  "properties": {
    "operationCount": {
      "type": "integer",
      "minimum": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "distribution": {
      "type": "string",
      "enum": ["UNIFORM", "ZIPFIAN"]
    },
    "zipfianTheta": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2.0
    },
    "keyRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readRatio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "writeRatio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "targetThroughputOpsSec": {
      "type": "number",
      "minimum": 1.0
    },
    "valueSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  },
  "additionalProperties": false
}
